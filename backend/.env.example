# Copy to .env and fill in. Never commit .env. Lines starting with # are comments.

# --- Django core ---
# Which settings file to use. Leave empty for local dev (config.settings.dev). Production: config.settings.prod
DJANGO_SETTINGS_MODULE=
# Long random string. Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# True/False. Only used by the dev settings (production is always False).
DEBUG=
# Comma-separated host names this backend serves, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=
# Comma-separated frontend origins allowed to call the API (scheme+host+port, no trailing slash).
CORS_ALLOWED_ORIGINS=
# Comma-separated origins trusted for CSRF (same format as CORS).
CSRF_TRUSTED_ORIGINS=

# --- URLs of this project ---
# Where the React app runs (no trailing slash). Used for payment return URL, email links, password reset, CORS.
FRONTEND_URL=
# Public URL of THIS backend (no trailing slash). Used for the payment callback URL.
PUBLIC_DOMAIN=

# --- Database (remote PostgreSQL) ---
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require  (leave empty to fall back to local SQLite)
DATABASE_URL=

# --- Cloudinary (media uploads) ---
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Optional: URL of a logo image shown in notification emails.
FINOT_LOGO_URL=

# --- Chapa (payments) ---
# Test-mode secret key from the Chapa dashboard (CHAPA_TEST_PRIV_... or CHASECK_TEST-...). Use the PRIVATE key, not the public one
CHAPA_SECRET_KEY=
# Chapa API server. Leave empty for https://api.chapa.global/v1 (needed for keys from dashboard.chapa.global).
CHAPA_API_BASE_URL=
# Optional: webhook secret. If empty, CHAPA_SECRET_KEY is used to verify webhooks.
CHAPA_WEBHOOK_SECRET=

# --- Email ---
# Dev default is the console backend (emails print in the terminal). For real mail use:
# django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
# Gmail: an App Password (needs 2-step verification), not your normal password
EMAIL_HOST_PASSWORD=
# From address on outgoing mail (defaults to EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=

# --- Push notifications (optional) ---
# Firebase service-account JSON, base64-encoded. Leave empty to disable push.
FIREBASE_CREDENTIALS_B64=
# Alternative: path to the service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# --- API rate limits (optional) ---
# Format: <number>/minute. Defaults: anonymous 30/minute, logged-in 42/minute.
THROTTLE_ANON=
THROTTLE_USER=
THROTTLE_LOGIN_IP=
THROTTLE_LOGIN_USER=
# How many proxies are in front of the app (Render: 1). Leave empty on a laptop.
NUM_PROXIES=
# Days a bulk-registered student may use the printed slip (default 21)
ACCOUNT_SETUP_GRACE_DAYS=


# --- Weekly reminder scheduler ---
# Long random string. The GitHub workflow sends it as X-Cron-Token. Empty = trigger disabled.
CRON_SECRET=
