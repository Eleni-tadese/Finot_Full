# Copy this file to ".env" only if you want the app to use another server (for example your own computer).
# These values are public: everything inside a mobile app can be read, so never put a secret here.
#
# For a server running on your computer, use your computer's address on the Wi-Fi, not "localhost":
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=https://finot-api.onrender.com
